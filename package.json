{
  "name": "otc-mern-pwa",
  "version": "1.0.0",
  "type": "module",
  "description": "Dynamic MERN Stack OTC Trading PWA with Lowest-Bet-Wins Algorithm",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server\" \"npm run client:dev\"",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  }
}
